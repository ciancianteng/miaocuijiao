{
  "regions": ["hkg1"],
  "crons": [
    {
      "path": "/api/cron/order-auto-complete",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/companion",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/companion/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/customer-service",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/customer-service/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/src/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/ranking", "destination": "/ranking.html" },
    { "source": "/leaderboard", "destination": "/ranking.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/orders", "destination": "/orders.html" },
    { "source": "/recharge", "destination": "/recharge.html" },
    { "source": "/recharge/", "destination": "/recharge.html" },
    { "source": "/more-gameplays", "destination": "/more-gameplays.html" },
    { "source": "/gameplay-product", "destination": "/gameplay-product.html" },
    { "source": "/fixed-order", "destination": "/fixed-order.html" },
    { "source": "/team-lobby", "destination": "/team-lobby.html" },
    { "source": "/custom-order", "destination": "/custom-order.html" },
    { "source": "/payment-confirm", "destination": "/payment-confirm.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/support/", "destination": "/support.html" },
    { "source": "/club-levels", "destination": "/club-levels.html" },
    { "source": "/club-levels/", "destination": "/club-levels.html" },
    { "source": "/companion.html", "destination": "/companion/index.html" },
    { "source": "/companion/login", "destination": "/companion/login/index.html" },
    { "source": "/companion/login/", "destination": "/companion/login/index.html" },
    { "source": "/companion", "destination": "/companion/index.html" },
    { "source": "/companion/", "destination": "/companion/index.html" },
    { "source": "/companion/:path*", "destination": "/companion/index.html" },
    { "source": "/customer-service/login", "destination": "/customer-service/login/index.html" },
    { "source": "/customer-service/login/", "destination": "/customer-service/login/index.html" },
    { "source": "/customer-service/conversations", "destination": "/customer-service/conversations/index.html" },
    { "source": "/customer-service/conversations/", "destination": "/customer-service/conversations/index.html" },
    { "source": "/customer-service/chats", "destination": "/customer-service/conversations/index.html" },
    { "source": "/customer-service/chats/", "destination": "/customer-service/conversations/index.html" },
    { "source": "/customer-service", "destination": "/customer-service/index.html" },
    { "source": "/customer-service/", "destination": "/customer-service/index.html" },
    { "source": "/customer-service/:path*", "destination": "/customer-service/index.html" },
    { "source": "/admin/login", "destination": "/admin/login/index.html" },
    { "source": "/admin/login/", "destination": "/admin/login/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/report", "destination": "/report/index.html" },
    { "source": "/report/:path*", "destination": "/report/index.html" },
    { "source": "/api/:seg/:path+", "destination": "/api/gateway?path=:seg/:path+" }
  ]
}
