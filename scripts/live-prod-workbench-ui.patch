+.pw-rm input{width:96px;height:36px;border-radius:10px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);color:#fff;padding:0 8px}
+
+/* Companion dashboard visual — black / pink, mobile first. Later rules win over compact overrides. */
+.pw-app{background:#0B0A10}
+.pw-status-switch[hidden]{display:none !important}
+.pw-status-panel.compact{
+  display:grid;
+  grid-template-columns:minmax(0,1fr) auto;
+  align-items:center;
+  gap:10px 12px;
+  margin:0 0 14px;
+  padding:16px !important;
+  border-radius:18px;
+  background:#19141F;
+  border:1px solid rgba(244,166,200,.18);
+  box-shadow:none;
+}
+.pw-status-panel.compact .pw-status-current{
+  margin:0 !important;
+  display:grid;
+  gap:4px;
+  min-width:0;
+}
+.pw-status-panel.compact .pw-status-current span{
+  font-size:12px;
+  font-weight:600;
+  color:#AFA6B5;
+}
+.pw-status-panel.compact .pw-status-current strong{
+  font-size:18px !important;
+  font-weight:720;
+  color:#fff;
+  line-height:1.25;
+}
+.pw-status-toggle{
+  height:36px;
+  padding:0 14px;
+  border-radius:999px;
+  border:1px solid rgba(244,166,200,.55);
+  background:transparent;
+  color:#F4A6C8;
+  font-size:13px;
+  font-weight:700;
+}
+.pw-status-panel:not(.is-open) .pw-status-hint{display:none}
+.pw-status-panel.is-open .pw-status-switch,
+.pw-status-panel.is-open .pw-status-hint{grid-column:1 / -1}
+.pw-status-emoji{display:none}
+.pw-grid--dash{
+  grid-template-columns:1fr 1fr;
+  gap:10px;
+}
+.pw-grid--dash .pw-metric{
+  display:grid;
+  align-content:space-between;
+  min-height:96px !important;
+  padding:14px !important;
+  border-radius:16px;
+  background:#241D2B !important;
+  border:1px solid rgba(244,166,200,.1) !important;
+  box-shadow:none;
+}
+.pw-grid--dash .pw-metric span{font-size:12px;color:#AFA6B5}
+.pw-grid--dash .pw-metric strong{
+  font-size:26px !important;
+  font-weight:720 !important;
+  color:#fff;
+  letter-spacing:-.02em;
+}
+.pw-grid--dash .pw-metric.is-zero strong{color:rgba(255,255,255,.72) !important}
+.pw-grid--dash .pw-metric.is-clickable{cursor:pointer}
+.pw-designated-card{
+  display:flex;
+  align-items:center;
+  justify-content:space-between;
+  gap:12px;
+  margin:14px 0 0;
+  padding:16px;
+  border-radius:18px;
+  background:#19141F;
+  border:1px solid #F4A6C8;
+}
+.pw-designated-copy{display:grid;gap:2px;min-width:0}
+.pw-designated-copy p{margin:0;color:#AFA6B5;font-size:13px}
