# ============================================================
# Production（正式站）— 正式密钥
# 填入 Vercel → Project → Settings → Environment Variables
# 作用范围只勾选：Production
# 切勿把正式密钥勾到 Preview
# ============================================================

APP_ENV=production

# --- Supabase 正式项目 ---
SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# --- HitPay Live ---
HITPAY_MODE=live
HITPAY_API_BASE_URL=https://api.hit-pay.com/v1
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_WEBHOOK_SECRET=

# --- 加密与会话（必须与 Staging 不同） ---
PLATFORM_SECRETS_ENCRYPTION_KEY=
PAYMENT_ENCRYPTION_KEY=
SERVICE_SESSION_SECRET=
COMPANION_SESSION_SECRET=

# --- 可选 ---
RESEND_API_KEY=
RESEND_FROM=MEOW CUI JIAO <noreply@your-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AI_API_KEY=
# SMS reserved for later (MVP disabled)
SMS_API_KEY=
# FRONTEND_ORIGINS=https://your-production-domain.com
