      "src": "^/report(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?$",
      "dest": "/report/index.html?path=$1",
      "check": true
    },
    {
      "src": "^/api(?:/([^/]+?))(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))$",
      "dest": "/api/gateway?path=$1%2F$2%20&seg=$1",
      "check": true
    },
    {
      "src": "^/api/([^/]+)$",
      "dest": "/api/[...path]?...path=$1",
      "check": true
    },
    {
      "src": "^/api(/.*)?$",
      "status": 404
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    },
    {
      "handle": "miss"
    },
    {
      "src": "^/api/(.+)(?:\\.(?:js))$",
      "dest": "/api/$1",
      "check": true
    }
  ],
  "framework": {
    "slug": "vite",
    "version": "8.1.3"
  },
  "crons": []
}
