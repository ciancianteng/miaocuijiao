# ============================================================
# Preview / Staging（公开预览）— 测试密钥
# 填入 Vercel → Project → Settings → Environment Variables
# 作用范围只勾选：Preview（可选再勾 Development）
# 切勿勾选 Production
# ============================================================

APP_ENV=preview

# --- Supabase 测试项目 ---
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# --- HitPay Sandbox ---
HITPAY_MODE=sandbox
HITPAY_API_BASE_URL=https://api.sandbox.hit-pay.com/v1
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_WEBHOOK_SECRET=

# --- 加密与会话（Staging 可单独一套，勿与 Production 共用） ---
PLATFORM_SECRETS_ENCRYPTION_KEY=
PAYMENT_ENCRYPTION_KEY=
SERVICE_SESSION_SECRET=
COMPANION_SESSION_SECRET=

# --- 可选 ---
RESEND_API_KEY=
RESEND_FROM=MEOW CUI JIAO <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AI_API_KEY=
# SMS reserved for later (MVP disabled)
SMS_API_KEY=
# ALLOW_STAGING_OTP=1
# FRONTEND_ORIGINS=https://your-preview.vercel.app
