# ============================================================
# Local development — copy to .env.local (never commit secrets)
# Prefer Staging / Sandbox values locally. See:
#   .env.preview.example   → Vercel Preview (公开预览 / Staging)
#   .env.production.example → Vercel Production (正式)
#   STAGING_SETUP.md / PRODUCTION_SETUP.md / DEPLOY_CHECKLIST.md
# ============================================================

APP_ENV=preview

# --- Supabase (use TEST project for local + Preview) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe only (never put service_role / secret here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias for publishable/anon key
VITE_SUPABASE_ANON_KEY=

# FORBIDDEN in frontend / Git / VITE_*:
# VITE_SUPABASE_SERVICE_ROLE_KEY
# VITE_SUPABASE_SECRET_KEY

# --- HitPay ---
# Preview / local: sandbox
# Production: live (see .env.production.example)
HITPAY_MODE=sandbox
HITPAY_API_BASE_URL=https://api.sandbox.hit-pay.com/v1
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_WEBHOOK_SECRET=

# Encrypt vault for SMTP / AI / SMS secrets stored via admin UI
PLATFORM_SECRETS_ENCRYPTION_KEY=
PAYMENT_ENCRYPTION_KEY=

# Mail (password may also be stored encrypted in platform_secret_vault)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI Meow butler (key must stay server-side)
AI_API_KEY=

# Optional SMS
SMS_API_KEY=

SERVICE_SESSION_SECRET=
COMPANION_SESSION_SECRET=

# Optional: comma-separated frontend origins allowed for CORS (localhost + *.vercel.app are allowed by default)
# FRONTEND_ORIGINS=https://your-custom-domain.com
